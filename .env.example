# Example environment file for the AI Compliance Runtime.
# Copy to `.env` and edit. `.env` is gitignored and never committed.
#
# All configuration is loaded through src/compliance_runtime/config/loader.py.
# That module is the ONLY place os.getenv / os.environ is read (Lesson 8).

# Path to the runtime YAML config. Defaults to configs/runtime.yaml.
CR_RUNTIME_CONFIG=configs/runtime.yaml

# Path to the eval YAML config. Defaults to configs/eval.yaml.
CR_EVAL_CONFIG=configs/eval.yaml

# Optional override for the signing-key directory.
# Defaults to the value in configs/runtime.yaml (~/.compliance-runtime/keys).
# CR_KEYS_DIR=~/.compliance-runtime/keys

# Optional log level override (DEBUG, INFO, WARNING, ERROR).
# CR_LOG_LEVEL=INFO

# NOTE: never put private keys or long-lived secrets in this file.
# Values of variables whose names contain KEY, TOKEN, SECRET, or PEM are
# scrubbed from logs, but they still should not live in a committed example.
