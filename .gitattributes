# Normalize line endings; mark binaries so git does not mangle them.
* text=auto eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.db binary
*.db-shm binary
*.db-wal binary

*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sql text eol=lf
*.txt text eol=lf
